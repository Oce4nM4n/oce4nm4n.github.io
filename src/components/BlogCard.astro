---
import type { CollectionEntry } from 'astro:content';

export interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { title, description, date, tags, theme } = entry.data;
---

<a
  href={`/blog/${entry.id}/`}
  class="group block rounded-xl border border-border bg-white p-6 transition-base hover:-translate-y-0.5 hover:border-accent hover:shadow-lg"
>
  <div class="mb-3 flex flex-wrap gap-2">
    {
      tags
        .slice(0, 3)
        .map((tag) => (
          <span class="rounded-full bg-bg-secondary px-2.5 py-0.5 text-xs text-text-secondary">
            #{tag}
          </span>
        ))
    }
  </div>
  <h3 class="mb-2 text-xl font-semibold group-hover:text-accent">{title}</h3>
  <p class="mb-4 text-sm leading-relaxed text-text-secondary">{description}</p>
  <div class="flex items-center justify-between">
    <time class="text-xs text-text-secondary" datetime={date.toISOString()}>
      {date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
    </time>
    <span
      class="inline-block h-2 w-2 rounded-full"
      style={{ backgroundColor: `var(--theme-${theme})` }}></span>
  </div>
</a>
