---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About — My Website" description="About me and my work">
  <div class="container-narrow py-16">
    <h1 class="mb-8 text-4xl font-bold">About</h1>

    <div class="prose-custom">
      <h2>Who I Am</h2>
      <p>
        I'm a developer and researcher passionate about AI, physics, and building things. This
        website serves as my technical blog, project portfolio, and research notebook.
      </p>

      <h2>Academic Interests</h2>
      <ul>
        <li>Artificial Intelligence and Machine Learning</li>
        <li>Theoretical Physics</li>
        <li>Mathematics and Computation</li>
      </ul>

      <h2>Technical Interests</h2>
      <ul>
        <li>Full-stack web development</li>
        <li>Local AI and open-source models</li>
        <li>Interactive data visualization</li>
        <li>DevOps and cloud infrastructure</li>
      </ul>

      <h2>Contact</h2>
      <p>
        Feel free to reach out via <a href="mailto:hello@example.com">email</a>
        or find me on <a
          href="https://github.com/username"
          target="_blank"
          rel="noopener noreferrer">GitHub</a
        >.
      </p>
    </div>
  </div>
</BaseLayout>
