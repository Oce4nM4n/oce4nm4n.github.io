---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About me" description="About me, my work and my hobbies">
  <div class="container-narrow py-16">
    <h1 class="mb-8 text-4xl font-bold">About</h1>

    <div class="prose-custom">
      <h2>Who I Am</h2>
      <p>
        I'm a undergraduate student at Denmark's Technical University, studying General engineering. This
        website serves as my take on what a personal website should be: a research notebook and a way to express my interests and personality.
      </p>

      <h2>Academic Interests</h2>
      <ul>
        <li>Artificial Intelligence and Machine Learning</li>
        <li>Mathematics and Computation</li>
        <li>Experimental Physics</li>
      </ul>

      <h2>Technical Interests</h2>
      <ul>
        <li>Local AI and open-source models</li>
        <li>Cybersecurity and Ethical hacking</li>
      </ul>

      <h2>Contact</h2>
      <p>
        Feel free to reach out via <a href="mailto:ayushmansihag@gmail.com"> email </a>
        or find me on <a
          href="https://github.com/Oce4nM4n"
          target="_blank"
          rel="noopener noreferrer">GitHub</a
        >.
      </p>
    </div>
  </div>
</BaseLayout>
