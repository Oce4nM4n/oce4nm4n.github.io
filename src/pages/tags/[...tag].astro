---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog', ({ data }) => !data.draft);
  const tags = new Set(blogEntries.flatMap((entry) => entry.data.tags));
  return Array.from(tags).map((tag) => ({
    params: { tag },
    props: { tag },
  }));
}

const { tag } = Astro.props;

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const filteredPosts = allPosts
  .filter((post) => post.data.tags.includes(tag))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title={`#${tag} — My Website`} description={`Articles tagged with ${tag}`}>
  <div class="container-wide py-16">
    <header class="mb-12">
      <p class="mb-2 text-sm font-medium uppercase tracking-wider text-text-secondary">Tag</p>
      <h1 class="text-4xl font-bold">#{tag}</h1>
      <p class="mt-2 text-text-secondary">
        {filteredPosts.length} article{filteredPosts.length !== 1 ? 's' : ''}
      </p>
    </header>

    <div class="grid gap-6 sm:grid-cols-2">
      {filteredPosts.map((post) => <BlogCard entry={post} />)}
    </div>

    {
      filteredPosts.length === 0 && (
        <p class="py-12 text-center text-text-secondary">No articles with this tag.</p>
      )
    }
  </div>
</BaseLayout>
