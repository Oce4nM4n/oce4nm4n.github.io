---
import BaseLayout from './BaseLayout.astro';
import '../styles/global.css';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const { title, description, github, live, technologies, status } = entry.data;
---

<BaseLayout title={title} description={description}>
  <article class="container-narrow py-16">
    <header class="mb-12">
      <div class="mb-2 flex items-center gap-3">
        <span class="text-sm font-medium uppercase tracking-wider text-text-secondary">
          {status === 'active' ? 'Active Project' : status === 'archived' ? 'Archived' : 'Planned'}
        </span>
        <span
          class="h-1.5 w-1.5 rounded-full"
          class:list={{
            'bg-emerald-500': status === 'active',
            'bg-slate-400': status === 'archived',
            'bg-amber-500': status === 'planned',
          }}></span>
      </div>
      <h1 class="mb-4 text-4xl font-bold">{title}</h1>
      <p class="text-lg text-text-secondary">{description}</p>
      <div class="mt-6 flex flex-wrap gap-2">
        {
          technologies.map((tech) => (
            <span class="rounded-md bg-bg-secondary px-2.5 py-1 text-sm font-mono text-text-secondary">
              {tech}
            </span>
          ))
        }
      </div>
      <div class="mt-6 flex gap-4">
        {
          github && (
            <a
              href={github}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-lg border border-border px-4 py-2 text-sm transition-base hover:bg-bg-secondary"
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
              </svg>
              GitHub
            </a>
          )
        }
        {
          live && (
            <a
              href={live}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-lg bg-accent px-4 py-2 text-sm text-white transition-base hover:bg-accent-dark"
            >
              Live Demo
            </a>
          )
        }
      </div>
    </header>
    <div class="prose-custom">
      <slot />
    </div>
  </article>
</BaseLayout>
